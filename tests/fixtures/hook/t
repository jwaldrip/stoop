#!/bin/sh
# Fake hook runner for stoop's unit tests. Its contract is the table in the module doc of
# tests/units_fixture.rs; change both together. POSIX sh: it must run under dash.
#
# A word that does not start with '-' names a test. With no such word, the runner runs every
# *.t under the root except slow/ (and every *.u with T_U=1), in LC_ALL=C order, after
# <root>/lint when T_LINT=1. With test words it runs each one, relative to the cwd, after the
# programs the no-argument form uses to list its roster (the purity rule, spec 3.2). Words
# starting with '-' are logged and otherwise ignored. LOG (outside the root) gets the record.
# The knobs marked (IF) in the table act unless T_IF names a path that does not exist.

ROOT=$(cd "$(dirname "$0")" && pwd -P) || exit 2
STATUS=0
HELD=
TESTS=0
COUNT=0
for word in "$@"; do
	case $word in
		-*) ;;
		*) TESTS=1; COUNT=$((COUNT + 1)) ;;
	esac
done

note() {
	if [ -n "${LOG:-}" ]; then
		printf '%s\n' "$1" >> "$LOG"
	fi
}

# One log line for a value: newlines become '|'.
flat() {
	printf '%s' "$1" | tr '\n' '|'
}

# The FIFO hold: one read per invocation, after the first test, or after the test named by T_FIFO_AT.
hold() {
	if [ -n "${T_FIFO:-}" ] && [ -z "$HELD" ] \
		&& { [ -z "${T_FIFO_IF:-}" ] || [ -e "$T_FIFO_IF" ]; }; then
		if [ -z "${T_FIFO_AT:-}" ] || [ "$T_FIFO_AT" = "$1" ]; then
			HELD=1
			read -r _ < "$T_FIFO" || true
			# The pass marker that the test's release waits for (issue #87). The log's ran= line comes before the hold.
			printf '%s\n' "$1" >> "$T_FIFO.passed"
		fi
	fi
}

# The knobs marked (IF) act unless T_IF names a path that does not exist.
armed() {
	[ -z "${T_IF:-}" ] || [ -e "$T_IF" ]
}

run_lines() {
	if [ "$1" = 1 ]; then
		IFS= read -r _ || true
	fi
	while IFS= read -r line || [ -n "$line" ]; do
		if [ -n "$line" ]; then
			case $line in
				fail)
					note "failed=$2"
					STATUS=1
					;;
				env:*)
					name=${line#env:}
					case $name in
						''|[!A-Za-z_]*|*[!A-Za-z0-9_]*)
							note "failed=$2"
							STATUS=1
							;;
						*)
							eval "value=\${$name-}"
							if [ "$value" = fail ]; then
								note "failed=$2"
								STATUS=1
							fi
							;;
					esac
					;;
				*) cat "$ROOT/$line" ;;
			esac
		fi
	done
}

run_test() {
	if [ "$TESTS" = 1 ] && [ -n "${T_SKIP_TEST:-}" ] && [ "$1" = "$T_SKIP_TEST" ] && armed; then
		note "skipped=$1"
		return
	fi
	if [ "$TESTS" = 1 ] && [ "${T_STAT_UNIT:-}" = 1 ]; then
		note "statted=$1"
		if [ ! -e "$1" ]; then
			note "failed=$1"
			STATUS=1
		fi
		return
	fi
	note "ran=$1"
	if [ ! -f "$1" ]; then
		note "failed=$1"
		STATUS=1
		return
	fi
	if [ -n "${T_WRITE:-}" ] && [ "${T_WRITE_AT:-}" = "$1" ] && armed; then
		printf 'written\n' > "$T_WRITE"
	fi
	cached=0
	if [ "${T_CACHE+x}" = x ]; then
		case $T_CACHE in
			/*) cache_dir=$T_CACHE ;;
			*) cache_dir=$ROOT/$T_CACHE ;;
		esac
		header=$(stat -L -c '%i %s %y %z' -- "$1") || {
			note "failed=$1"
			STATUS=1
			return
		}
		entry=$cache_dir/${header%% *}.c
		if [ -f "$entry" ] && {
			IFS= read -r cached_header < "$entry" && [ "$cached_header" = "$header" ]
		}; then
			cached=1
			note "cache_hit=$1"
		else
			{ { printf '%s\n' "$header"; cat -- "$1"; } > "$entry"; } 2>/dev/null || true
		fi
	fi
	if [ "$cached" = 1 ]; then
		sed '1d' "$entry"
		run_lines 1 "$1" < "$entry"
	else
		cat "$1"
		run_lines 0 "$1" < "$1"
	fi
	cat "$ROOT/setup.src"
	if [ "${T_WRITE_EACH:-}" = 1 ]; then
		output="${1%.*}.out"
		if [ -n "${T_OUTPUT_DIR:-}" ]; then
			output="$ROOT/$T_OUTPUT_DIR/${1##*/}.out"
		fi
		printf 'written\n' > "$output"
	fi
	hold "$1"
	flag=${1%.*}.flag
	if [ -f "$flag" ] && grep -q fail "$flag"; then
		note "failed=$1"
		STATUS=1
	fi
	if [ "$TESTS" = 1 ] && [ -n "${T_FAIL_ALONE:-}" ] && [ "$1" = "$T_FAIL_ALONE" ] && armed; then
		note "failed=$1"
		STATUS=1
	fi
}

list_tests() {
	if [ "${T_U:-}" = 1 ]; then
		find . \( -name '.?*' -o -path ./slow \) -prune -o -type f \( -name '*.t' -o -name '*.u' \) -print
	else
		find . \( -name '.?*' -o -path ./slow \) -prune -o -type f -name '*.t' -print
	fi | sed 's|^\./||' | LC_ALL=C sort
}

note launch
for word in "$@"; do
	note "arg=$word"
done
note "changed=$(flat "${STOOP_CHANGED:-}")"
note "units=$(flat "${STOOP_UNITS:-}")"
note "changed_file=$(flat "${STOOP_CHANGED_FILE:-}")"
note "changed_inputs=$(flat "${STOOP_CHANGED_INPUTS:-}")"
note "changed_inputs_file=$(flat "${STOOP_CHANGED_INPUTS_FILE:-}")"
note "changed_set=${STOOP_CHANGED+1}"
note "units_set=${STOOP_UNITS+1}"
if [ "${T_CACHE+x}" = x ]; then
	note "cache=$T_CACHE"
fi

if [ -n "${T_WRITE:-}" ] && [ -z "${T_WRITE_AT:-}" ] && armed; then
	printf 'written\n' > "$T_WRITE"
fi
if [ "$TESTS" = 1 ] && [ "${T_IGNORE:-}" = 1 ]; then
	exit 0
fi
if [ "$TESTS" = 0 ] && [ "${T_LINT:-}" = 1 ]; then
	"$ROOT/lint"
fi
if [ "${T_LS_ROOT:-}" = 1 ]; then
	ls -a "$ROOT" > /dev/null
	note ls_root
fi
if [ "${T_STAT_ROOT:-}" = 1 ]; then
	test -d "$ROOT"
	note stat_root
fi
if [ -n "${T_READ_OTHER:-}" ] && armed; then
	if [ -p "$T_READ_OTHER" ]; then
		# A FIFO is held (issue #87): one line releases it, then the pass marker that the test waits for.
		read -r _ < "$T_READ_OTHER" || true
		printf 'read-other\n' >> "$T_READ_OTHER.passed"
	else
		cat "$T_READ_OTHER" > /dev/null
	fi
fi
if [ -n "${T_STAT_OTHER:-}" ] && armed; then
	test -e "$T_STAT_OTHER"
	note "stat_other=$T_STAT_OTHER"
fi
if [ "$COUNT" -ge 2 ] && [ -n "${T_GROUP_READ:-}" ] && armed; then
	cat "$ROOT/$T_GROUP_READ" > /dev/null
	note "group_read=$T_GROUP_READ"
fi

if [ "$TESTS" = 0 ]; then
	cd "$ROOT" || exit 2
	if [ -n "${T_WRITE_FULL:-}" ]; then
		printf 'written\n' > "$T_WRITE_FULL"
	fi
	set -f
	for P in $(list_tests); do
		run_test "$P"
	done
	set +f
	if [ "${T_FAIL_FULL:-}" = 1 ] && armed; then
		STATUS=1
	fi
	if [ -n "${T_GATE:-}" ] && grep -q fail "$ROOT/$T_GATE"; then
		STATUS=1
	fi
else
	find /dev/null -prune >/dev/null
	sed -n q </dev/null
	LC_ALL=C sort </dev/null >/dev/null
	for P in "$@"; do
		case $P in
			-*) ;;
			*) run_test "$P" ;;
		esac
	done
fi

exit "$STATUS"
